  lines:
  - speakerName: Raihn
    portrait: {fileID: 0}
    text: Welcome back.
    endsConversation: 0
    choices: []
  - speakerName: Raihn
    portrait: {fileID: 0}
    text: You gave us quite a scare back there.
    endsConversation: 0
    choices: []
  - speakerName: Raihn
    portrait: {fileID: 0}
    text: Here. This should help you recover.
    endsConversation: 0
    choices:
    - text: Accept the potion
      nextLine: 3
      flags:
      - flagId: raihnPotionAccepted
        value: 1
    - text: Decline the potion
      nextLine: 5
      flags:
      - flagId: raihnPotionDeclined
        value: 1
  - speakerName: Oraya
    portrait: {fileID: 0}
    text: Thank you.
    endsConversation: 0
    choices: []
  - speakerName: Raihn
    portrait: {fileID: 0}
    text: Try to get some rest. You've earned it.
    endsConversation: 1
    choices: []
  - speakerName: Oraya
    portrait: {fileID: 0}
    text: I can manage.
    endsConversation: 0
    choices: []
  - speakerName: Raihn
    portrait: {fileID: 0}
    text: Still as stubborn as ever.
    endsConversation: 1
    choices: []
